<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include head.liquid %}
    {% include paper_metadata.liquid %}
    <style>
      .paper-page {
        margin: 0 auto;
        max-width: 800px;
      }

      .paper-kicker {
        color: var(--global-theme-color);
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        margin-bottom: 0.75rem;
        text-transform: uppercase;
      }

      .paper-title {
        font-size: clamp(2rem, 5vw, 3.25rem);
        line-height: 1.12;
        margin-bottom: 1rem;
      }

      .paper-authors {
        font-size: 1.05rem;
        margin-bottom: 0.25rem;
      }

      .paper-venue {
        color: var(--global-text-color-light);
        margin-bottom: 1.5rem;
      }

      .paper-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin: 1.5rem 0 2.5rem;
      }

      .paper-link {
        border: 1px solid var(--global-theme-color);
        border-radius: 0.25rem;
        color: var(--global-theme-color);
        font-size: 0.9rem;
        font-weight: 500;
        padding: 0.4rem 0.8rem;
      }

      .paper-link:hover {
        background: var(--global-theme-color);
        color: var(--global-bg-color);
        text-decoration: none;
      }

      .paper-page section {
        margin-top: 2.25rem;
      }

      .paper-page section h2 {
        font-size: 1.45rem;
        margin-bottom: 0.8rem;
      }

      .paper-page pre {
        background: var(--global-code-bg-color);
        border: 1px solid var(--global-divider-color);
        border-radius: 0.25rem;
        font-size: 0.82rem;
        padding: 1rem;
        white-space: pre-wrap;
        word-break: break-word;
      }

      .paper-note {
        border-left: 3px solid var(--global-theme-color);
        color: var(--global-text-color-light);
        padding-left: 1rem;
      }

      .paper-back {
        border-top: 1px solid var(--global-divider-color);
        margin-top: 3rem;
        padding-top: 1.25rem;
      }
    </style>
  </head>

  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    {% include header.liquid %}

    <div class="container mt-5" role="main">
      <article class="paper-page">
        <header>
          <p class="paper-kicker">{{ page.paper.short_venue }} · {{ page.paper.year }}</p>
          <h1 class="paper-title">{{ page.title }}</h1>
          <p class="paper-authors">
            {% for author in page.paper.authors %}
              {% if author.orcid -%}
                <a href="{{ author.orcid }}">{{ author.name }}</a>
              {%- else -%}
                {{- author.name -}}
              {%- endif -%}
              {%- unless forloop.last %}, {% endunless %}
            {% endfor %}
          </p>
          <p class="paper-venue">
            {{ page.paper.venue -}}
            {%- if page.paper.status %} · {{ page.paper.status }}{% endif %}
          </p>

          <nav class="paper-links" aria-label="Paper links">
            {% if page.paper.external_url %}
              <a class="paper-link" href="{{ page.paper.external_url }}">{{ page.paper.external_label | default: 'Paper' }}</a>
            {% endif %}
            {% if page.paper.doi %}
              <a class="paper-link" href="https://doi.org/{{ page.paper.doi }}">DOI</a>
            {% endif %}
            {% if page.paper.arxiv %}
              <a class="paper-link" href="https://arxiv.org/abs/{{ page.paper.arxiv }}">arXiv</a>
            {% endif %}
            {% if page.paper.preprint_url %}
              <a class="paper-link" href="{{ page.paper.preprint_url }}">Earlier preprint</a>
            {% endif %}
            {% if page.paper.pdf_url %}
              {% if page.paper.pdf_url contains '://' %}
                <a class="paper-link" href="{{ page.paper.pdf_url }}">PDF</a>
              {% else %}
                <a class="paper-link" href="{{ page.paper.pdf_url | relative_url }}">PDF</a>
              {% endif %}
            {% endif %}
            {% if page.paper.code_url %}
              <a class="paper-link" href="{{ page.paper.code_url }}">Code</a>
            {% endif %}
          </nav>
        </header>

        <section>
          <h2>Overview</h2>
          <p>{{ page.summary }}</p>
        </section>

        {% if page.contributions %}
          <section>
            <h2>What the paper contributes</h2>
            <ul>
              {% for contribution in page.contributions %}
                <li>{{ contribution }}</li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}

        <section>
          <h2>Abstract</h2>
          <p>{{ page.abstract }}</p>
        </section>

        {% if page.availability_note %}
          <section>
            <p class="paper-note">{{ page.availability_note }}</p>
          </section>
        {% endif %}

        {% if content != blank %}
          <section>{{ content }}</section>
        {% endif %}

        <section>
          <h2>Citation</h2>
          <pre><code>{{ page.bibtex | escape }}</code></pre>
        </section>

        <p class="paper-back"><a href="{{ '/publications/' | relative_url }}">← All publications</a></p>
      </article>
    </div>

    {% include footer.liquid %}
    {% include scripts.liquid %}
  </body>
</html>
