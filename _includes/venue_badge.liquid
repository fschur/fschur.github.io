{%- assign badge = include.badge -%}
{%- if badge -%}
  {%- if site.data.venues[badge] -%}
    {% assign venue_style = null %}
    {% if site.data.venues[badge].color != blank %}
      {% assign venue_style = site.data.venues[badge].color | prepend: 'style="background-color:' | append: '"' %}
    {%- endif -%}
    <abbr
      class="badge rounded w-100"
      {% if venue_style %}
        {{ venue_style }}
      {% endif -%}
    >
      {% if site.data.venues[badge].url %}
        <a href="{{ site.data.venues[badge].url }}">{{ badge }}</a>
      {% else %}
        <div>{{- badge -}}</div>
      {% endif %}
    </abbr>
  {% else %}
    <abbr class="badge rounded w-100">{{ badge }}</abbr>
  {% endif %}
{%- endif -%}
